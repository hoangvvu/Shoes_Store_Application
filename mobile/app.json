{
  "expo": {
    "name": "OURAN",
    "slug": "ouran-mobile",
    "version": "1.0.0",
    "scheme": "ouran",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": false },
    "android": { "softwareKeyboardLayoutMode": "resize" },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": false }
  }
}
