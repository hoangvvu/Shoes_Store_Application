NODE_ENV=development
PORT=5000

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ShoeStore
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# JWT (đặt chuỗi ngẫu nhiên dài >= 32 ký tự)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Web admin (nhiều origin cách nhau bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173
