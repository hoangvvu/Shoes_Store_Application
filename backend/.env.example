# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - SHOES STORE BACKEND CORE
# ==============================================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# KẾT NỐI CƠ SỞ DỮ LIỆU MICROSOFT SQL SERVER (T-SQL)
# ------------------------------------------------------------------------------
DB_SERVER=LAPTOPVJPPRO
DB_NAME=ShoeStore
DB_USER=
DB_PASSWORD=
DB_PORT=1433
DB_USE_WINDOWS_AUTH=true
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------------------------
# BẢO MẬT XÁC THỰC JWT
# ------------------------------------------------------------------------------
JWT_SECRET=shoesstore_jwt_secret_key_2026_cnpm
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=shoesstore_jwt_refresh_key_2026_cnpm
JWT_REFRESH_EXPIRES_IN=7d
