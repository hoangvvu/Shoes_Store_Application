# ==============================================================================
# HỆ THỐNG CẤU HÌNH BIẾN MÔI TRƯỜNG - SHOES STORE APP BACKEND
# ==============================================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# KẾT NỐI SERVERLESS POSTGRESQL (NEON / SUPABASE / VERCEL POSTGRES)
# ------------------------------------------------------------------------------
# 1. DATABASE_URL: Dùng chuỗi kết nối qua Connection Pooler (PgBouncer)
#    Ví dụ Neon: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require&pgbouncer=true
#    Ví dụ Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/shoes_store_db?sslmode=prefer"

# 2. DIRECT_URL: Dùng chuỗi kết nối trực tiếp (Direct Connection) không qua pooler
#    Bắt buộc đối với Serverless Postgres khi chạy `prisma migrate` và DDL
#    Ví dụ Neon: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
#    Ví dụ Supabase: postgresql://postgres:[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL="postgresql://postgres:password@localhost:5432/shoes_store_db?sslmode=prefer"

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET="shoesstore_super_secret_jwt_key_2026_cnpm"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# CẤU HÌNH DỊCH VỤ AI MICROSERVICE (PYTHON FASTAPI)
# ------------------------------------------------------------------------------
AI_SERVICE_URL="http://localhost:8000/api/v1"
AI_API_KEY="shoesstore_ai_secret_token_2026"
