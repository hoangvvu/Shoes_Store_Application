# ==============================================================================
# TẬP TIN LOẠI TRỪ GIT (GITIGNORE) - SHOES STORE APPLICATION
# Dành cho dự án Monorepo: Backend + Admin (Vite) + Mobile (Expo)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THƯ MỤC CÀI ĐẶT THƯ VIỆN (DEPENDENCIES)
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
admin/node_modules/
backend/node_modules/
mobile/node_modules/

# Giữ lại lockfiles để đồng bộ phiên bản thư viện giữa các máy (KHÔNG ignore lockfile)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Log rác của các trình quản lý gói
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 2. BIẾN MÔI TRƯỜNG & THÔNG TIN BẢO MẬT (ENV & SECRETS)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
*.env.*

# Loại trừ tất cả .env trừ các file ví dụ mẫu (.env.example)
!.env.example
!*.env.example
!backend/.env.example

# Thông tin Cloud & AI tools / Agents
.neon
.agents/
skills-lock.json

# ------------------------------------------------------------------------------
# 3. BACKEND SPECIFIC (NODE.JS / EXPRESS)
# ------------------------------------------------------------------------------
backend/backup/
backend/test/
*.http
test_api.js
test_api.log

# ------------------------------------------------------------------------------
# 4. ADMIN APP SPECIFIC (REACT + VITE / WEB FRONTEND)
# ------------------------------------------------------------------------------
dist/
build/
out/
.cache/
.turbo/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. MOBILE APP SPECIFIC (EXPO / REACT NATIVE)
# ------------------------------------------------------------------------------
.expo/
mobile/.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
android/app/build/
android/.gradle/
ios/Pods/

# ------------------------------------------------------------------------------
# 6. LOGS & FILE TẠM CỦA HỆ THỐNG
# ------------------------------------------------------------------------------
logs/
*.log
tmp/
temp/

# ------------------------------------------------------------------------------
# 7. CẤU HÌNH HỆ ĐIỀU HÀNH & EDITOR / IDE
# ------------------------------------------------------------------------------
# Hệ điều hành
.DS_Store
Thumbs.db
desktop.ini

# IDE (VS Code & WebStorm)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json